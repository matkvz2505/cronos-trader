# Copie para .env e ajuste. O boot falha com mensagem clara se algo estiver faltando.

NODE_ENV=development
PORT=1840

# Postgres do docker-compose deste diretório (porta 5460 no host).
DATABASE_URL="postgresql://trader:trader@localhost:5460/cronos_trader?schema=public"

# Troque em produção. Precisa de 32+ caracteres.
JWT_SECRET="troque-este-valor-de-desenvolvimento-por-um-segredo-real-de-64-chars"
JWT_EXPIRA_EM=15m
REFRESH_EXPIRA_DIAS=30

# Serviço de IA em Python — onde o motor de padrões roda de fato.
IA_URL=http://localhost:1841
IA_TIMEOUT_MS=120000

# Origens liberadas no CORS, separadas por vírgula.
CORS_ORIGENS=http://localhost:5180

LOG_NIVEL=debug
WS_INTERVALO_MS=5000
