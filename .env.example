# Copie para .env na raiz. O docker-compose lê daqui.
# Tudo aqui tem default no compose — a stack sobe sem este arquivo, com valores de
# desenvolvimento. Troque antes de expor qualquer coisa fora da sua máquina.

# Assinatura dos access tokens. Mínimo de 32 caracteres; o backend recusa o boot abaixo
# disso, e recusa também se ainda contiver a palavra "desenvolvimento" em produção.
JWT_SECRET=troque-este-valor-de-desenvolvimento-por-um-segredo-real-de-64-chars

# --- tools (agentes, Sprint 7) ----------------------------------------------
# Uma chave só: toda a cadeia de modelos roda pelo OpenRouter, em três camadas de custo
# (free → barato → forte). Ver tools/litellm/config.yaml.
LITELLM_MASTER_KEY=sk-cronos-trader-dev
OPENROUTER_API_KEY=

# --- coletor MT5 (roda no HOST, não em container) ---------------------------
# O pacote MetaTrader5 é Windows-only e fala com o terminal por IPC. Ele aponta para o
# Postgres publicado pelo compose:
#   $env:DATABASE_URL = "postgresql://trader:trader@localhost:5460/cronos_trader"
#
# VOCÊ NÃO PRECISA DAS TRÊS VARIÁVEIS ABAIXO no uso normal. O coletor se acopla ao
# terminal que já está logado — você faz login uma vez, pela interface do MT5, e pronto.
#
# Preencha SÓ se quiser que o coletor logue sozinho (útil para sobreviver a um reboot
# sem alguém digitando senha). São credenciais de conta de investimento: este arquivo
# está no .gitignore e deve continuar assim.
#
# MT5_LOGIN=                 # número da conta, só dígitos
# MT5_SENHA=                 # senha de NEGOCIAÇÃO, não a do site da corretora
# MT5_SERVIDOR=              # ex.: ClearCorretora-DEMO — exatamente como a corretora informou
# MT5_CAMINHO=               # opcional, se houver mais de um terminal instalado
